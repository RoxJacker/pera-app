# Variables de entorno — NO subir a Git
# Copia este archivo a .env.local y llena los valores

# Supabase (pública — usada en la app Expo via EXPO_PUBLIC_)
EXPO_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY

# Supabase (privada — solo para el backend /api en Vercel)
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# URL del backend (en desarrollo usa localhost, en prod usa tu dominio Vercel)
EXPO_PUBLIC_API_URL=http://localhost:3000
